{
    "keybindings" : {
        "ctrl-u"    : "unzip {path}",
        
        "ctrl-q"    : "exit",
        "ctrl-r"    : "reload",
        "home"      : "select_first",
        "end"       : "select_last",
        
        "up"        : "select_previous",
        "ctrl-k"    : "select_previous",
        "down"      : "select_next",
        "ctrl-j"    : "select_next",
        "left"      : "go_out",
        "ctrl-h"    : "go_out",
        "right"     : "go_into",
        "ctrl-l"    : "go_into",

        "shift"     : "select_multiple",
        "ctrl-a"    : "select_all",

        "ctrl-x"    : "cut",
        "ctrl-c"    : "copy",
        "ctrl-v"    : "paste",
        "ctrl-n"    : "new",
        "del"       : "delete",
        "f2"        : "rename",

        "alt-h"     : "home",
        "enter"     : "open",
        "space"     : "go_into_or_open",
        "ctrl-e"    : "open_on_explorer",
        
        "ctrl-t"    : "toggle_preview",
